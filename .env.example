# Live provider: "decart" (default) or "fal".
# Switch without code changes: set LIVE_PROVIDER=fal and restart the server.
LIVE_PROVIDER=decart

# Required when LIVE_PROVIDER=decart: permanent Decart key; server-side only, never expose to browser code.
DECART_API_KEY=dct_your_decart_api_key_here

# Required when LIVE_PROVIDER=fal: fal.ai API key; server-side only, never expose to browser code.
# Create at https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# Required: exact trusted origins allowed to request short-lived tokens.
# Use scheme + host + optional port, no path or trailing slash. Separate multiple origins with commas.
# In development, http://localhost:* and http://127.0.0.1:* are also trusted automatically
# (dev.allowLoopbackOrigins in livebridge.config.ts), so preview proxies on random ports work.
# In production only this exact list applies.
APP_ORIGINS=http://localhost:3000

# Testing viewer key. The OBS Browser Source link is /obs?key= plus this value.
# OBS subscribe currently works only with LIVE_PROVIDER=decart.
OBS_KEY=zam
